---
interface Props {
    id: string;
}
const { id } = Astro.props;
---
<div class="poneglyph" data-pone-id={id} title="A mysterious ancient stone...">
    <div class="stone">
        <div class="glyphs"></div>
    </div>
</div>

<style>
    .poneglyph {
        width: 30px;
        height: 40px;
        cursor: pointer;
        position: absolute;
        z-index: 100;
        transition: all 0.3s ease;
        filter: drop-shadow(0 0 5px rgba(239, 68, 68, 0.3));
        animation: pone-glint 5s infinite;
    }

    @keyframes pone-glint {
        0%, 90%, 100% { transform: scale(1); filter: drop-shadow(0 0 5px rgba(239, 68, 68, 0.3)); }
        95% { transform: scale(1.1); filter: drop-shadow(0 0 15px rgba(239, 68, 68, 0.8)); }
    }

    .poneglyph:hover {
        transform: scale(1.1);
        filter: drop-shadow(0 0 15px rgba(239, 68, 68, 0.8));
    }

    .poneglyph.collected {
        filter: grayscale(1) opacity(0.2);
        pointer-events: none;
    }

    .stone {
        width: 100%;
        height: 100%;
        background: #1a1a1a;
        border: 2px solid #ef4444;
        border-radius: 4px;
        position: relative;
        overflow: hidden;
    }

    .glyphs {
        position: absolute;
        inset: 2px;
        background-image: 
            radial-gradient(circle at 50% 50%, #ef4444 1px, transparent 1px),
            radial-gradient(circle at 20% 30%, #ef4444 1px, transparent 1px),
            radial-gradient(circle at 80% 70%, #ef4444 1px, transparent 1px);
        background-size: 8px 8px;
        opacity: 0.6;
    }

    /* Secret Animation when hovered */
    .poneglyph:hover .glyphs {
        animation: glyph-flicker 0.2s infinite alternate;
    }

    @keyframes glyph-flicker {
        from { opacity: 0.6; }
        to { opacity: 1; }
    }
</style>
